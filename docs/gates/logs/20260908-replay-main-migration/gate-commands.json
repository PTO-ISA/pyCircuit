{
  "contracts": [
    "python",
    "-m",
    "unittest",
    "discover",
    "-s",
    "tests/python/agentic-circuit/contracts",
    "-p",
    "test_*.py"
  ],
  "viewer": [
    "env",
    "PYTHONPATH=third_party/circuit-flow-viewer/src",
    "python",
    "-m",
    "unittest",
    "discover",
    "-s",
    "third_party/circuit-flow-viewer/tests",
    "-v"
  ],
  "unit": [
    "python",
    "-m",
    "pytest",
    "tests/unit",
    "-m",
    "unit",
    "-q"
  ],
  "hygiene": [
    "python",
    "flows/tools/check_api_hygiene.py",
    "python/pycircuit/src/pycircuit",
    "examples/pycircuit",
    "docs",
    "README.md"
  ],
  "decisions": [
    "python",
    "flows/tools/check_decision_status.py",
    "--rfc",
    "docs/rfcs/pyc6-decisions.md",
    "--status",
    "docs/gates/decision_status_v6.md",
    "--out",
    ".pycircuit_out/replay/main-migration/decision_status_report.json",
    "--require-no-deferred",
    "--require-all-verified",
    "--require-concrete-evidence",
    "--require-existing-evidence"
  ],
  "docs": [
    "python",
    "-m",
    "mkdocs",
    "build",
    "--site-dir",
    ".pycircuit_out/replay/main-migration/site"
  ]
}