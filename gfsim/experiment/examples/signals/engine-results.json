mple; only step + HALT check timed; observer off; gc.collect before timing',\n 'baseline_commit':'c811811','source_sha256':{name:hashlib.sha256((p/'engine.py').read_bytes()).hexdigest() for name,p in paths.items()},\n 'median_time_ratio':statistics.median(ratios),'workloads':rows,'worker_source':worker}\n(root/'examples/signals/engine-results.json').write_text(json.dumps(report,indent=2)+'\\n')\nprint('median new/old:',report['median_time_ratio'])\n"
