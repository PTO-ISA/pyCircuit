set(stage "@CMAKE_CURRENT_BINARY_DIR@/install-test-stage")
set(prefix "@CMAKE_CURRENT_BINARY_DIR@/install-test-relocated")
set(consumer "@CMAKE_CURRENT_BINARY_DIR@/install-test-consumer")
# All directories are private test products in the build tree.
file(REMOVE_RECURSE "${stage}" "${prefix}" "${consumer}")
execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@" --prefix "${stage}" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Installation failed")
endif()
file(RENAME "${stage}" "${prefix}")
execute_process(COMMAND "@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/examples/external" -B "${consumer}" "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "External configure failed")
endif()
execute_process(COMMAND "@CMAKE_COMMAND@" --build "${consumer}" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "External link failed")
endif()
execute_process(COMMAND "${consumer}/consumer" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "External executable failed")
endif()
