#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"
# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"

usage() {
  cat <<'EOF'
Usage: flows/scripts/pyc <build|smoke>

build configures and installs the pyCircuit source compiler and pyc6 runtime.
The compiler requires LLVM/MLIR 22.1.8 exactly. Set LLVM_DIR and MLIR_DIR, or
provide llvm-config-22 (or LLVM_CONFIG) from that installation.

Environment:
  PYC_BUILD_DIR             Build directory (default: .pycircuit_out/toolchain/build)
  PYC_INSTALL_PREFIX        Install prefix (default: .pycircuit_out/toolchain/install)
  PYC_BUILD_TESTING         Native compiler tests, ON by default for this gate
  PYC_PYTHON_EXECUTABLE     Python interpreter used by CMake
EOF
}

find_llvm_config() {
  if [[ -n "${LLVM_CONFIG:-}" && -x "${LLVM_CONFIG}" ]]; then
    printf '%s\n' "${LLVM_CONFIG}"
  elif command -v llvm-config-22 >/dev/null 2>&1; then
    command -v llvm-config-22
  elif command -v llvm-config >/dev/null 2>&1 && [[ "$(llvm-config --version)" == "22.1.8" ]]; then
    command -v llvm-config
  else
    return 1
  fi
}

cmd="${1:-help}"
shift || true
case "${cmd}" in
  -h|--help|help) usage ;;
  build)
    build_dir="${PYC_BUILD_DIR:-${ROOT_DIR}/.pycircuit_out/toolchain/build}"
    install_prefix="${PYC_INSTALL_PREFIX:-${ROOT_DIR}/.pycircuit_out/toolchain/install}"
    while (($#)); do
      case "$1" in
        --build-dir) build_dir="${2:?missing value for --build-dir}"; shift 2 ;;
        --install-prefix) install_prefix="${2:?missing value for --install-prefix}"; shift 2 ;;
        *) pyc_die "unknown build option: $1" ;;
      esac
    done

    if [[ -z "${LLVM_DIR:-}" || -z "${MLIR_DIR:-}" ]]; then
      llvm_config="$(find_llvm_config)" || pyc_die "set LLVM_DIR and MLIR_DIR for LLVM/MLIR 22.1.8"
      version="$("${llvm_config}" --version)"
      [[ "${version}" == "22.1.8" ]] || pyc_die "LLVM 22.1.8 is required; ${llvm_config} reports ${version}"
      LLVM_DIR="$("${llvm_config}" --cmakedir)"
      MLIR_DIR="$(dirname "${LLVM_DIR}")/mlir"
      export LLVM_DIR MLIR_DIR
    fi

    python_exec="${PYC_PYTHON_EXECUTABLE:-$(command -v python3)}"
    cmake -S "${ROOT_DIR}" -B "${build_dir}" -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX="${install_prefix}" \
      -DPYC_BUILD_COMPILER_DEV=ON \
      -DPYC_BUILD_TESTING="${PYC_BUILD_TESTING:-ON}" \
      -DPYC_BUILD_RUNTIME_LIB=ON \
      -DPYC_INSTALL_PYTHON=ON \
      -DPython3_EXECUTABLE="${python_exec}" \
      -DLLVM_DIR="${LLVM_DIR}" -DMLIR_DIR="${MLIR_DIR}"
    cmake --build "${build_dir}" --parallel
    cmake --install "${build_dir}" --prefix "${install_prefix}"
    export PYC_TOOLCHAIN_ROOT="${install_prefix}"
    pyc_log "installed source compiler helpers and pyc6_runtime in ${install_prefix}"
    ;;
  smoke)
    if [[ -z "${PYC_TOOLCHAIN_ROOT:-}" ]]; then
      PYC_TOOLCHAIN_ROOT="${ROOT_DIR}/.pycircuit_out/toolchain/install"
    fi
    [[ -x "${PYC_TOOLCHAIN_ROOT}/bin/pycircuit" ]] || pyc_die "missing installed pycircuit driver under ${PYC_TOOLCHAIN_ROOT}"
    export PYC_TOOLCHAIN_ROOT
    bash "${ROOT_DIR}/flows/scripts/run_examples.sh" --tier gate
    ;;
  *) pyc_die "unknown command: ${cmd} (run: flows/scripts/pyc help)" ;;
esac
