        "bypass_mask": ["pending_mask", "alias_mask", "disjoint_mask", "identity_match_mask", "killed_mask"],
        "forward_mask": ["pending_mask", "alias_mask", "data_ready_mask", "executed_mask", "identity_match_mask", "killed_mask"],
        "replay_mask": ["pending_mask", "alias_mask", "executed_mask", "identity_match_mask", "killed_mask"],
        "stale_mask": ["pending_mask", "identity_match_mask", "killed_mask"]
      },
      "zero_input": {
        "wait_mask": 0,
        "bypass_mask": 0,
        "forward_mask": 0,
        "replay_mask": 0,
