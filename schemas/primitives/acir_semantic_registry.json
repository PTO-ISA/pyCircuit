        {"name": "resource_masks", "type": "iN list", "constraints": ["1 <= N <= 64", "at least one mask"]}
      ],
      "outputs": [
        {"name": "common_mask", "type": "iN"}
      ],
      "latency": 0,
      "dependency_matrix": {"common_mask": ["resource_masks"]},
      "zero_input": {"common_mask": 0}
    },
    {
