{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pto-isa:agentic-circuit:schema:pto-trace-oracle-report:0.1",
  "title": "PTO Trace Oracle Report 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "contract_epoch", "status", "trace_content_hash", "reference_model", "candidate_model", "timestamp_profile", "comparisons", "first_divergence"],
  "properties": {
    "schema": {"const": "agentic-circuit-pto-trace-oracle-report"},
    "version": {"const": "0.1"},
    "contract_epoch": {"const": "0.5"},
    "status": {"enum": ["passed", "failed"]},
    "trace_content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference_model": {"$ref": "urn:pto-isa:agentic-circuit:schema:pto-trace-result:0.1#/$defs/model"},
    "candidate_model": {"$ref": "urn:pto-isa:agentic-circuit:schema:pto-trace-result:0.1#/$defs/model"},
    "timestamp_profile": {"$ref": "urn:pto-isa:agentic-circuit:schema:pto-trace-result:0.1#/$defs/timestampProfile"},
    "comparisons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_identity", "record_count", "opcode_counts", "architectural_values", "completion_order", "retirement_order", "observable_timestamps"],
      "properties": {
        "trace_identity": {"type": "boolean"},
        "record_count": {"type": "boolean"},
        "opcode_counts": {"type": "boolean"},
        "architectural_values": {"type": "boolean"},
        "completion_order": {"type": "boolean"},
        "retirement_order": {"type": "boolean"},
        "observable_timestamps": {"type": "boolean"}
      }
    },
    "first_divergence": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/divergence"}
      ]
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        {"type": ["string", "number", "integer", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    },
    "nullableUint": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "nullableString": {"type": ["string", "null"]},
    "divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_id", "opcode", "stage", "field", "reference", "candidate", "reference_cycle", "candidate_cycle"],
      "properties": {
        "sequence_id": {"$ref": "#/$defs/nullableUint"},
        "opcode": {"$ref": "#/$defs/nullableString"},
        "stage": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "reference": {"$ref": "#/$defs/jsonValue"},
        "candidate": {"$ref": "#/$defs/jsonValue"},
        "reference_cycle": {"$ref": "#/$defs/nullableUint"},
        "candidate_cycle": {"$ref": "#/$defs/nullableUint"}
      }
    }
  }
}
