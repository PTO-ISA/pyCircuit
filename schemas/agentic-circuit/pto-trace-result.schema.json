{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pto-isa:agentic-circuit:schema:pto-trace-result:0.1",
  "title": "PTO Trace Model Result 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "contract_epoch", "trace_content_hash", "model", "records", "timestamp_profile", "run_timestamps"],
  "properties": {
    "schema": {"const": "agentic-circuit-pto-trace-result"},
    "version": {"const": "0.1"},
    "contract_epoch": {"const": "0.5"},
    "trace_content_hash": {"$ref": "#/$defs/sha256"},
    "model": {"$ref": "#/$defs/model"},
    "records": {"type": "array", "maxItems": 65536, "items": {"$ref": "#/$defs/record"}},
    "timestamp_profile": {"$ref": "#/$defs/timestampProfile"},
    "run_timestamps": {"$ref": "#/$defs/timestamps"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "portableInt": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revision", "specialization"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "specialization": {"type": "string", "minLength": 1}
      }
    },
    "timestamps": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {"$ref": "#/$defs/uint"}
    },
    "timestampProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_stages", "run_stages"],
      "properties": {
        "record_stages": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "run_stages": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_id", "opcode", "architectural_value", "completion_ordinal", "retirement_ordinal", "timestamps"],
      "properties": {
        "sequence_id": {"$ref": "#/$defs/uint"},
        "opcode": {"type": "string", "minLength": 1},
        "architectural_value": {"$ref": "#/$defs/portableInt"},
        "completion_ordinal": {"$ref": "#/$defs/uint"},
        "retirement_ordinal": {"$ref": "#/$defs/uint"},
        "timestamps": {"$ref": "#/$defs/timestamps"}
      }
    }
  }
}
