{
  "$id": "https://pto-isa.org/schemas/agentic-circuit/consumer-lock-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pyCircuit SDK consumer lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "release",
    "source_revision",
    "release_index",
    "platform",
    "wheels",
    "abi",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "pycircuit-sdk-lock"
    },
    "version": {
      "const": "1"
    },
    "release": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_index": {
      "$ref": "#/$defs/reference"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "archive",
        "manifest"
      ],
      "properties": {
        "id": {
          "enum": [
            "linux-x86_64",
            "macos-arm64",
            "windows-x86_64"
          ]
        },
        "archive": {
          "$ref": "#/$defs/asset"
        },
        "manifest": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "wheels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentic-circuit",
        "pycircuit-hisi",
        "pycircuit-semantic-core"
      ],
      "properties": {
        "agentic-circuit": {
          "$ref": "#/$defs/wheel"
        },
        "pycircuit-hisi": {
          "$ref": "#/$defs/wheel"
        },
        "pycircuit-semantic-core": {
          "$ref": "#/$defs/wheel"
        }
      }
    },
    "abi": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\.whl$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
