// Trace-driven DavinciOO-shaped out-of-order timing model.
// IQ and ROB capacities are 32; regenerate those modules with expand_ooo.py.
builtin.module attributes {ac.contract_epoch = "0.3"} {
  ac.protocol @rv {
    ac.role @producer dual @consumer cardinality "exclusive"
    ac.role @consumer dual @producer cardinality "exclusive"
    ac.state @idle initial true terminal false
    ac.state @moved initial false terminal true
    ac.event @offer from @producer to @consumer payload i64 action "offer"
    ac.transition from @idle to @moved on @offer transfer true retain false guard {}
  }

  ac.module @TraceSource() parameters {} graph {
    ac.queue @cursor payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "cursor" path "cursor" watermarks {kind = "register"}
    ac.queue @eof_reported payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "eof_reported" path "eof_reported" watermarks {kind = "register"}
    ac.stat @fetched kind "counter"
    ac.process @step kind "control" {
      %c0 = arith.constant 0 : i64
      %c1 = arith.constant 1 : i64
      %cursor, %cursor_valid = ac.try_recv @cursor : i64
      %reported, %reported_valid = ac.try_recv @eof_reported : i64
      %cursor_index = arith.index_cast %cursor : i64 to index
      %next_index, %handle, %advanced = ac.trace.next %cursor_index from source "pto" : i64
      scf.if %advanced {
        %sent = ac.try_send @Core::@rob_in %handle : i64
        scf.if %sent {
          ac.stat.add @fetched %c1 : i64
          ac.trace.event %handle lane "Frontend" phase "fetch" : i64
        }
        %next_i64 = arith.index_cast %next_index : index to i64
        %saved_cursor = arith.select %sent, %next_i64, %cursor : i64
        %cursor_stored = ac.try_send @cursor %saved_cursor : i64
      } else {
        %cursor_stored = ac.try_send @cursor %cursor : i64
      }
      %eof = ac.trace.eof %cursor_index from source "pto"
      %not_reported = arith.cmpi eq, %reported, %c0 : i64
      %report_eof = arith.andi %eof, %not_reported : i1
      scf.if %report_eof {
        %position = ac.trace.position %cursor_index from source "pto"
        %total = arith.index_cast %position : index to i64
        %sent_total = ac.try_send @Core::@trace_total %total : i64
        %new_reported = arith.select %sent_total, %c1, %c0 : i64
        %reported_stored = ac.try_send @eof_reported %new_reported : i64
      } else {
        %reported_stored = ac.try_send @eof_reported %reported : i64
      }
      ac.yield_sim
    }
    ac.return
  }

  ac.module @ROB() parameters {} graph {
    ac.queue @head payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "head" path "head" watermarks {kind = "register"}
    ac.queue @tail payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "tail" path "tail" watermarks {kind = "register"}
    ac.queue @done0 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done0" path "done0" watermarks {kind = "register"}
    ac.queue @done1 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done1" path "done1" watermarks {kind = "register"}
    ac.queue @done2 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done2" path "done2" watermarks {kind = "register"}
    ac.queue @done3 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done3" path "done3" watermarks {kind = "register"}
    ac.queue @done4 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done4" path "done4" watermarks {kind = "register"}
    ac.queue @done5 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done5" path "done5" watermarks {kind = "register"}
    ac.queue @done6 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done6" path "done6" watermarks {kind = "register"}
    ac.queue @done7 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done7" path "done7" watermarks {kind = "register"}
    ac.queue @done8 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done8" path "done8" watermarks {kind = "register"}
    ac.queue @done9 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done9" path "done9" watermarks {kind = "register"}
    ac.queue @done10 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done10" path "done10" watermarks {kind = "register"}
    ac.queue @done11 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done11" path "done11" watermarks {kind = "register"}
    ac.queue @done12 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done12" path "done12" watermarks {kind = "register"}
    ac.queue @done13 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done13" path "done13" watermarks {kind = "register"}
    ac.queue @done14 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done14" path "done14" watermarks {kind = "register"}
    ac.queue @done15 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done15" path "done15" watermarks {kind = "register"}
    ac.queue @done16 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done16" path "done16" watermarks {kind = "register"}
    ac.queue @done17 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done17" path "done17" watermarks {kind = "register"}
    ac.queue @done18 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done18" path "done18" watermarks {kind = "register"}
    ac.queue @done19 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done19" path "done19" watermarks {kind = "register"}
    ac.queue @done20 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done20" path "done20" watermarks {kind = "register"}
    ac.queue @done21 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done21" path "done21" watermarks {kind = "register"}
    ac.queue @done22 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done22" path "done22" watermarks {kind = "register"}
    ac.queue @done23 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done23" path "done23" watermarks {kind = "register"}
    ac.queue @done24 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done24" path "done24" watermarks {kind = "register"}
    ac.queue @done25 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done25" path "done25" watermarks {kind = "register"}
    ac.queue @done26 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done26" path "done26" watermarks {kind = "register"}
    ac.queue @done27 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done27" path "done27" watermarks {kind = "register"}
    ac.queue @done28 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done28" path "done28" watermarks {kind = "register"}
    ac.queue @done29 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done29" path "done29" watermarks {kind = "register"}
    ac.queue @done30 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done30" path "done30" watermarks {kind = "register"}
    ac.queue @done31 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "done31" path "done31" watermarks {kind = "register"}
    ac.stat @retired kind "counter"
    ac.stat @opcode_0 kind "counter"
    ac.stat @opcode_1 kind "counter"
    ac.stat @opcode_2 kind "counter"
    ac.stat @opcode_3 kind "counter"
    ac.stat @opcode_4 kind "counter"
    ac.stat @opcode_5 kind "counter"
    ac.stat @opcode_vec kind "counter"
    ac.stat @scalar kind "counter"
    ac.stat @vector kind "counter"
    ac.stat @cube kind "counter"
    ac.stat @tlsu kind "counter"
    ac.process @step kind "control" {
      %c0 = arith.constant 0 : i64
      %c1 = arith.constant 1 : i64
      %c2 = arith.constant 2 : i64
      %c3 = arith.constant 3 : i64
      %c4 = arith.constant 4 : i64
      %c5 = arith.constant 5 : i64
      %c6 = arith.constant 6 : i64
      %c7 = arith.constant 7 : i64
      %c8 = arith.constant 8 : i64
      %c9 = arith.constant 9 : i64
      %c10 = arith.constant 10 : i64
      %c11 = arith.constant 11 : i64
      %c12 = arith.constant 12 : i64
      %c13 = arith.constant 13 : i64
      %c14 = arith.constant 14 : i64
      %c15 = arith.constant 15 : i64
      %c16 = arith.constant 16 : i64
      %c17 = arith.constant 17 : i64
      %c18 = arith.constant 18 : i64
      %c19 = arith.constant 19 : i64
      %c20 = arith.constant 20 : i64
      %c21 = arith.constant 21 : i64
      %c22 = arith.constant 22 : i64
      %c23 = arith.constant 23 : i64
      %c24 = arith.constant 24 : i64
      %c25 = arith.constant 25 : i64
      %c26 = arith.constant 26 : i64
      %c27 = arith.constant 27 : i64
      %c28 = arith.constant 28 : i64
      %c29 = arith.constant 29 : i64
      %c30 = arith.constant 30 : i64
      %c31 = arith.constant 31 : i64
      %c32 = arith.constant 32 : i64
      %c255 = arith.constant 255 : i64
      %mask31 = arith.constant 31 : i64
      %true = arith.constant true
      %head, %head_valid = ac.try_recv @head : i64
      %tail, %tail_valid = ac.try_recv @tail : i64
      %d0, %dv0 = ac.try_recv @done0 : i64
      %d1, %dv1 = ac.try_recv @done1 : i64
      %d2, %dv2 = ac.try_recv @done2 : i64
      %d3, %dv3 = ac.try_recv @done3 : i64
      %d4, %dv4 = ac.try_recv @done4 : i64
      %d5, %dv5 = ac.try_recv @done5 : i64
      %d6, %dv6 = ac.try_recv @done6 : i64
      %d7, %dv7 = ac.try_recv @done7 : i64
      %d8, %dv8 = ac.try_recv @done8 : i64
      %d9, %dv9 = ac.try_recv @done9 : i64
      %d10, %dv10 = ac.try_recv @done10 : i64
      %d11, %dv11 = ac.try_recv @done11 : i64
      %d12, %dv12 = ac.try_recv @done12 : i64
      %d13, %dv13 = ac.try_recv @done13 : i64
      %d14, %dv14 = ac.try_recv @done14 : i64
      %d15, %dv15 = ac.try_recv @done15 : i64
      %d16, %dv16 = ac.try_recv @done16 : i64
      %d17, %dv17 = ac.try_recv @done17 : i64
      %d18, %dv18 = ac.try_recv @done18 : i64
      %d19, %dv19 = ac.try_recv @done19 : i64
      %d20, %dv20 = ac.try_recv @done20 : i64
      %d21, %dv21 = ac.try_recv @done21 : i64
      %d22, %dv22 = ac.try_recv @done22 : i64
      %d23, %dv23 = ac.try_recv @done23 : i64
      %d24, %dv24 = ac.try_recv @done24 : i64
      %d25, %dv25 = ac.try_recv @done25 : i64
      %d26, %dv26 = ac.try_recv @done26 : i64
      %d27, %dv27 = ac.try_recv @done27 : i64
      %d28, %dv28 = ac.try_recv @done28 : i64
      %d29, %dv29 = ac.try_recv @done29 : i64
      %d30, %dv30 = ac.try_recv @done30 : i64
      %d31, %dv31 = ac.try_recv @done31 : i64
      %completed, %has_completed = ac.try_recv @Core::@rob_done : i64
      %completed_desc = ac.trace.decode %completed : i64 to i64
      %completed_seq = arith.andi %completed_desc, %c255 : i64
      %completed_slot_base = arith.andi %completed_seq, %mask31 : i64
      %completed_slot = arith.addi %completed_slot_base, %c1 : i64
      %complete0a = arith.cmpi eq, %completed_slot, %c1 : i64
      %complete0 = arith.andi %has_completed, %complete0a : i1
      %sd0 = arith.select %complete0, %c1, %d0 : i64
      %complete1a = arith.cmpi eq, %completed_slot, %c2 : i64
      %complete1 = arith.andi %has_completed, %complete1a : i1
      %sd1 = arith.select %complete1, %c1, %d1 : i64
      %complete2a = arith.cmpi eq, %completed_slot, %c3 : i64
      %complete2 = arith.andi %has_completed, %complete2a : i1
      %sd2 = arith.select %complete2, %c1, %d2 : i64
      %complete3a = arith.cmpi eq, %completed_slot, %c4 : i64
      %complete3 = arith.andi %has_completed, %complete3a : i1
      %sd3 = arith.select %complete3, %c1, %d3 : i64
      %complete4a = arith.cmpi eq, %completed_slot, %c5 : i64
      %complete4 = arith.andi %has_completed, %complete4a : i1
      %sd4 = arith.select %complete4, %c1, %d4 : i64
      %complete5a = arith.cmpi eq, %completed_slot, %c6 : i64
      %complete5 = arith.andi %has_completed, %complete5a : i1
      %sd5 = arith.select %complete5, %c1, %d5 : i64
      %complete6a = arith.cmpi eq, %completed_slot, %c7 : i64
      %complete6 = arith.andi %has_completed, %complete6a : i1
      %sd6 = arith.select %complete6, %c1, %d6 : i64
      %complete7a = arith.cmpi eq, %completed_slot, %c8 : i64
      %complete7 = arith.andi %has_completed, %complete7a : i1
      %sd7 = arith.select %complete7, %c1, %d7 : i64
      %complete8a = arith.cmpi eq, %completed_slot, %c9 : i64
      %complete8 = arith.andi %has_completed, %complete8a : i1
      %sd8 = arith.select %complete8, %c1, %d8 : i64
      %complete9a = arith.cmpi eq, %completed_slot, %c10 : i64
      %complete9 = arith.andi %has_completed, %complete9a : i1
      %sd9 = arith.select %complete9, %c1, %d9 : i64
      %complete10a = arith.cmpi eq, %completed_slot, %c11 : i64
      %complete10 = arith.andi %has_completed, %complete10a : i1
      %sd10 = arith.select %complete10, %c1, %d10 : i64
      %complete11a = arith.cmpi eq, %completed_slot, %c12 : i64
      %complete11 = arith.andi %has_completed, %complete11a : i1
      %sd11 = arith.select %complete11, %c1, %d11 : i64
      %complete12a = arith.cmpi eq, %completed_slot, %c13 : i64
      %complete12 = arith.andi %has_completed, %complete12a : i1
      %sd12 = arith.select %complete12, %c1, %d12 : i64
      %complete13a = arith.cmpi eq, %completed_slot, %c14 : i64
      %complete13 = arith.andi %has_completed, %complete13a : i1
      %sd13 = arith.select %complete13, %c1, %d13 : i64
      %complete14a = arith.cmpi eq, %completed_slot, %c15 : i64
      %complete14 = arith.andi %has_completed, %complete14a : i1
      %sd14 = arith.select %complete14, %c1, %d14 : i64
      %complete15a = arith.cmpi eq, %completed_slot, %c16 : i64
      %complete15 = arith.andi %has_completed, %complete15a : i1
      %sd15 = arith.select %complete15, %c1, %d15 : i64
      %complete16a = arith.cmpi eq, %completed_slot, %c17 : i64
      %complete16 = arith.andi %has_completed, %complete16a : i1
      %sd16 = arith.select %complete16, %c1, %d16 : i64
      %complete17a = arith.cmpi eq, %completed_slot, %c18 : i64
      %complete17 = arith.andi %has_completed, %complete17a : i1
      %sd17 = arith.select %complete17, %c1, %d17 : i64
      %complete18a = arith.cmpi eq, %completed_slot, %c19 : i64
      %complete18 = arith.andi %has_completed, %complete18a : i1
      %sd18 = arith.select %complete18, %c1, %d18 : i64
      %complete19a = arith.cmpi eq, %completed_slot, %c20 : i64
      %complete19 = arith.andi %has_completed, %complete19a : i1
      %sd19 = arith.select %complete19, %c1, %d19 : i64
      %complete20a = arith.cmpi eq, %completed_slot, %c21 : i64
      %complete20 = arith.andi %has_completed, %complete20a : i1
      %sd20 = arith.select %complete20, %c1, %d20 : i64
      %complete21a = arith.cmpi eq, %completed_slot, %c22 : i64
      %complete21 = arith.andi %has_completed, %complete21a : i1
      %sd21 = arith.select %complete21, %c1, %d21 : i64
      %complete22a = arith.cmpi eq, %completed_slot, %c23 : i64
      %complete22 = arith.andi %has_completed, %complete22a : i1
      %sd22 = arith.select %complete22, %c1, %d22 : i64
      %complete23a = arith.cmpi eq, %completed_slot, %c24 : i64
      %complete23 = arith.andi %has_completed, %complete23a : i1
      %sd23 = arith.select %complete23, %c1, %d23 : i64
      %complete24a = arith.cmpi eq, %completed_slot, %c25 : i64
      %complete24 = arith.andi %has_completed, %complete24a : i1
      %sd24 = arith.select %complete24, %c1, %d24 : i64
      %complete25a = arith.cmpi eq, %completed_slot, %c26 : i64
      %complete25 = arith.andi %has_completed, %complete25a : i1
      %sd25 = arith.select %complete25, %c1, %d25 : i64
      %complete26a = arith.cmpi eq, %completed_slot, %c27 : i64
      %complete26 = arith.andi %has_completed, %complete26a : i1
      %sd26 = arith.select %complete26, %c1, %d26 : i64
      %complete27a = arith.cmpi eq, %completed_slot, %c28 : i64
      %complete27 = arith.andi %has_completed, %complete27a : i1
      %sd27 = arith.select %complete27, %c1, %d27 : i64
      %complete28a = arith.cmpi eq, %completed_slot, %c29 : i64
      %complete28 = arith.andi %has_completed, %complete28a : i1
      %sd28 = arith.select %complete28, %c1, %d28 : i64
      %complete29a = arith.cmpi eq, %completed_slot, %c30 : i64
      %complete29 = arith.andi %has_completed, %complete29a : i1
      %sd29 = arith.select %complete29, %c1, %d29 : i64
      %complete30a = arith.cmpi eq, %completed_slot, %c31 : i64
      %complete30 = arith.andi %has_completed, %complete30a : i1
      %sd30 = arith.select %complete30, %c1, %d30 : i64
      %complete31a = arith.cmpi eq, %completed_slot, %c32 : i64
      %complete31 = arith.andi %has_completed, %complete31a : i1
      %sd31 = arith.select %complete31, %c1, %d31 : i64
      %occupancy = arith.subi %tail, %head : i64
      %room = arith.cmpi ult, %occupancy, %c32 : i64
      %incoming, %has_incoming = scf.if %room -> (i64, i1) {
        %value, %valid = ac.try_recv @Core::@rob_in : i64
        scf.yield %value, %valid : i64, i1
      } else {
        %zero_valid = arith.cmpi ne, %c0, %c0 : i64
        scf.yield %c0, %zero_valid : i64, i1
      }
      scf.if %has_incoming {
        %forwarded = ac.try_send @Core::@rob_to_rename %incoming : i64
      }
      %new_tail0 = arith.addi %tail, %c1 : i64
      %new_tail = arith.select %has_incoming, %new_tail0, %tail : i64
      %head_slot_base = arith.andi %head, %mask31 : i64
      %head_slot = arith.addi %head_slot_base, %c1 : i64
      %head_is30 = arith.cmpi eq, %head_slot, %c31 : i64
      %hd30 = arith.select %head_is30, %sd30, %sd31 : i64
      %head_is29 = arith.cmpi eq, %head_slot, %c30 : i64
      %hd29 = arith.select %head_is29, %sd29, %hd30 : i64
      %head_is28 = arith.cmpi eq, %head_slot, %c29 : i64
      %hd28 = arith.select %head_is28, %sd28, %hd29 : i64
      %head_is27 = arith.cmpi eq, %head_slot, %c28 : i64
      %hd27 = arith.select %head_is27, %sd27, %hd28 : i64
      %head_is26 = arith.cmpi eq, %head_slot, %c27 : i64
      %hd26 = arith.select %head_is26, %sd26, %hd27 : i64
      %head_is25 = arith.cmpi eq, %head_slot, %c26 : i64
      %hd25 = arith.select %head_is25, %sd25, %hd26 : i64
      %head_is24 = arith.cmpi eq, %head_slot, %c25 : i64
      %hd24 = arith.select %head_is24, %sd24, %hd25 : i64
      %head_is23 = arith.cmpi eq, %head_slot, %c24 : i64
      %hd23 = arith.select %head_is23, %sd23, %hd24 : i64
      %head_is22 = arith.cmpi eq, %head_slot, %c23 : i64
      %hd22 = arith.select %head_is22, %sd22, %hd23 : i64
      %head_is21 = arith.cmpi eq, %head_slot, %c22 : i64
      %hd21 = arith.select %head_is21, %sd21, %hd22 : i64
      %head_is20 = arith.cmpi eq, %head_slot, %c21 : i64
      %hd20 = arith.select %head_is20, %sd20, %hd21 : i64
      %head_is19 = arith.cmpi eq, %head_slot, %c20 : i64
      %hd19 = arith.select %head_is19, %sd19, %hd20 : i64
      %head_is18 = arith.cmpi eq, %head_slot, %c19 : i64
      %hd18 = arith.select %head_is18, %sd18, %hd19 : i64
      %head_is17 = arith.cmpi eq, %head_slot, %c18 : i64
      %hd17 = arith.select %head_is17, %sd17, %hd18 : i64
      %head_is16 = arith.cmpi eq, %head_slot, %c17 : i64
      %hd16 = arith.select %head_is16, %sd16, %hd17 : i64
      %head_is15 = arith.cmpi eq, %head_slot, %c16 : i64
      %hd15 = arith.select %head_is15, %sd15, %hd16 : i64
      %head_is14 = arith.cmpi eq, %head_slot, %c15 : i64
      %hd14 = arith.select %head_is14, %sd14, %hd15 : i64
      %head_is13 = arith.cmpi eq, %head_slot, %c14 : i64
      %hd13 = arith.select %head_is13, %sd13, %hd14 : i64
      %head_is12 = arith.cmpi eq, %head_slot, %c13 : i64
      %hd12 = arith.select %head_is12, %sd12, %hd13 : i64
      %head_is11 = arith.cmpi eq, %head_slot, %c12 : i64
      %hd11 = arith.select %head_is11, %sd11, %hd12 : i64
      %head_is10 = arith.cmpi eq, %head_slot, %c11 : i64
      %hd10 = arith.select %head_is10, %sd10, %hd11 : i64
      %head_is9 = arith.cmpi eq, %head_slot, %c10 : i64
      %hd9 = arith.select %head_is9, %sd9, %hd10 : i64
      %head_is8 = arith.cmpi eq, %head_slot, %c9 : i64
      %hd8 = arith.select %head_is8, %sd8, %hd9 : i64
      %head_is7 = arith.cmpi eq, %head_slot, %c8 : i64
      %hd7 = arith.select %head_is7, %sd7, %hd8 : i64
      %head_is6 = arith.cmpi eq, %head_slot, %c7 : i64
      %hd6 = arith.select %head_is6, %sd6, %hd7 : i64
      %head_is5 = arith.cmpi eq, %head_slot, %c6 : i64
      %hd5 = arith.select %head_is5, %sd5, %hd6 : i64
      %head_is4 = arith.cmpi eq, %head_slot, %c5 : i64
      %hd4 = arith.select %head_is4, %sd4, %hd5 : i64
      %head_is3 = arith.cmpi eq, %head_slot, %c4 : i64
      %hd3 = arith.select %head_is3, %sd3, %hd4 : i64
      %head_is2 = arith.cmpi eq, %head_slot, %c3 : i64
      %hd2 = arith.select %head_is2, %sd2, %hd3 : i64
      %head_is1 = arith.cmpi eq, %head_slot, %c2 : i64
      %hd1 = arith.select %head_is1, %sd1, %hd2 : i64
      %head_is0 = arith.cmpi eq, %head_slot, %c1 : i64
      %hd0 = arith.select %head_is0, %sd0, %hd1 : i64
      %can_retire = arith.cmpi eq, %hd0, %c1 : i64
      %new_head0 = arith.addi %head, %c1 : i64
      %new_head = arith.select %can_retire, %new_head0, %head : i64
      %retire_slot0a = arith.cmpi eq, %head_slot, %c1 : i64
      %retire_slot0 = arith.andi %can_retire, %retire_slot0a : i1
      %nd0 = arith.select %retire_slot0, %c0, %sd0 : i64
      %retire_slot1a = arith.cmpi eq, %head_slot, %c2 : i64
      %retire_slot1 = arith.andi %can_retire, %retire_slot1a : i1
      %nd1 = arith.select %retire_slot1, %c0, %sd1 : i64
      %retire_slot2a = arith.cmpi eq, %head_slot, %c3 : i64
      %retire_slot2 = arith.andi %can_retire, %retire_slot2a : i1
      %nd2 = arith.select %retire_slot2, %c0, %sd2 : i64
      %retire_slot3a = arith.cmpi eq, %head_slot, %c4 : i64
      %retire_slot3 = arith.andi %can_retire, %retire_slot3a : i1
      %nd3 = arith.select %retire_slot3, %c0, %sd3 : i64
      %retire_slot4a = arith.cmpi eq, %head_slot, %c5 : i64
      %retire_slot4 = arith.andi %can_retire, %retire_slot4a : i1
      %nd4 = arith.select %retire_slot4, %c0, %sd4 : i64
      %retire_slot5a = arith.cmpi eq, %head_slot, %c6 : i64
      %retire_slot5 = arith.andi %can_retire, %retire_slot5a : i1
      %nd5 = arith.select %retire_slot5, %c0, %sd5 : i64
      %retire_slot6a = arith.cmpi eq, %head_slot, %c7 : i64
      %retire_slot6 = arith.andi %can_retire, %retire_slot6a : i1
      %nd6 = arith.select %retire_slot6, %c0, %sd6 : i64
      %retire_slot7a = arith.cmpi eq, %head_slot, %c8 : i64
      %retire_slot7 = arith.andi %can_retire, %retire_slot7a : i1
      %nd7 = arith.select %retire_slot7, %c0, %sd7 : i64
      %retire_slot8a = arith.cmpi eq, %head_slot, %c9 : i64
      %retire_slot8 = arith.andi %can_retire, %retire_slot8a : i1
      %nd8 = arith.select %retire_slot8, %c0, %sd8 : i64
      %retire_slot9a = arith.cmpi eq, %head_slot, %c10 : i64
      %retire_slot9 = arith.andi %can_retire, %retire_slot9a : i1
      %nd9 = arith.select %retire_slot9, %c0, %sd9 : i64
      %retire_slot10a = arith.cmpi eq, %head_slot, %c11 : i64
      %retire_slot10 = arith.andi %can_retire, %retire_slot10a : i1
      %nd10 = arith.select %retire_slot10, %c0, %sd10 : i64
      %retire_slot11a = arith.cmpi eq, %head_slot, %c12 : i64
      %retire_slot11 = arith.andi %can_retire, %retire_slot11a : i1
      %nd11 = arith.select %retire_slot11, %c0, %sd11 : i64
      %retire_slot12a = arith.cmpi eq, %head_slot, %c13 : i64
      %retire_slot12 = arith.andi %can_retire, %retire_slot12a : i1
      %nd12 = arith.select %retire_slot12, %c0, %sd12 : i64
      %retire_slot13a = arith.cmpi eq, %head_slot, %c14 : i64
      %retire_slot13 = arith.andi %can_retire, %retire_slot13a : i1
      %nd13 = arith.select %retire_slot13, %c0, %sd13 : i64
      %retire_slot14a = arith.cmpi eq, %head_slot, %c15 : i64
      %retire_slot14 = arith.andi %can_retire, %retire_slot14a : i1
      %nd14 = arith.select %retire_slot14, %c0, %sd14 : i64
      %retire_slot15a = arith.cmpi eq, %head_slot, %c16 : i64
      %retire_slot15 = arith.andi %can_retire, %retire_slot15a : i1
      %nd15 = arith.select %retire_slot15, %c0, %sd15 : i64
      %retire_slot16a = arith.cmpi eq, %head_slot, %c17 : i64
      %retire_slot16 = arith.andi %can_retire, %retire_slot16a : i1
      %nd16 = arith.select %retire_slot16, %c0, %sd16 : i64
      %retire_slot17a = arith.cmpi eq, %head_slot, %c18 : i64
      %retire_slot17 = arith.andi %can_retire, %retire_slot17a : i1
      %nd17 = arith.select %retire_slot17, %c0, %sd17 : i64
      %retire_slot18a = arith.cmpi eq, %head_slot, %c19 : i64
      %retire_slot18 = arith.andi %can_retire, %retire_slot18a : i1
      %nd18 = arith.select %retire_slot18, %c0, %sd18 : i64
      %retire_slot19a = arith.cmpi eq, %head_slot, %c20 : i64
      %retire_slot19 = arith.andi %can_retire, %retire_slot19a : i1
      %nd19 = arith.select %retire_slot19, %c0, %sd19 : i64
      %retire_slot20a = arith.cmpi eq, %head_slot, %c21 : i64
      %retire_slot20 = arith.andi %can_retire, %retire_slot20a : i1
      %nd20 = arith.select %retire_slot20, %c0, %sd20 : i64
      %retire_slot21a = arith.cmpi eq, %head_slot, %c22 : i64
      %retire_slot21 = arith.andi %can_retire, %retire_slot21a : i1
      %nd21 = arith.select %retire_slot21, %c0, %sd21 : i64
      %retire_slot22a = arith.cmpi eq, %head_slot, %c23 : i64
      %retire_slot22 = arith.andi %can_retire, %retire_slot22a : i1
      %nd22 = arith.select %retire_slot22, %c0, %sd22 : i64
      %retire_slot23a = arith.cmpi eq, %head_slot, %c24 : i64
      %retire_slot23 = arith.andi %can_retire, %retire_slot23a : i1
      %nd23 = arith.select %retire_slot23, %c0, %sd23 : i64
      %retire_slot24a = arith.cmpi eq, %head_slot, %c25 : i64
      %retire_slot24 = arith.andi %can_retire, %retire_slot24a : i1
      %nd24 = arith.select %retire_slot24, %c0, %sd24 : i64
      %retire_slot25a = arith.cmpi eq, %head_slot, %c26 : i64
      %retire_slot25 = arith.andi %can_retire, %retire_slot25a : i1
      %nd25 = arith.select %retire_slot25, %c0, %sd25 : i64
      %retire_slot26a = arith.cmpi eq, %head_slot, %c27 : i64
      %retire_slot26 = arith.andi %can_retire, %retire_slot26a : i1
      %nd26 = arith.select %retire_slot26, %c0, %sd26 : i64
      %retire_slot27a = arith.cmpi eq, %head_slot, %c28 : i64
      %retire_slot27 = arith.andi %can_retire, %retire_slot27a : i1
      %nd27 = arith.select %retire_slot27, %c0, %sd27 : i64
      %retire_slot28a = arith.cmpi eq, %head_slot, %c29 : i64
      %retire_slot28 = arith.andi %can_retire, %retire_slot28a : i1
      %nd28 = arith.select %retire_slot28, %c0, %sd28 : i64
      %retire_slot29a = arith.cmpi eq, %head_slot, %c30 : i64
      %retire_slot29 = arith.andi %can_retire, %retire_slot29a : i1
      %nd29 = arith.select %retire_slot29, %c0, %sd29 : i64
      %retire_slot30a = arith.cmpi eq, %head_slot, %c31 : i64
      %retire_slot30 = arith.andi %can_retire, %retire_slot30a : i1
      %nd30 = arith.select %retire_slot30, %c0, %sd30 : i64
      %retire_slot31a = arith.cmpi eq, %head_slot, %c32 : i64
      %retire_slot31 = arith.andi %can_retire, %retire_slot31a : i1
      %nd31 = arith.select %retire_slot31, %c0, %sd31 : i64
      scf.if %can_retire {
        %retired_one = arith.constant 1 : i64
        ac.stat.add @retired %retired_one : i64
        %retired_desc = ac.trace.decode %head : i64 to i64
        %opcode_shifted = arith.shrui %retired_desc, %c8 : i64
        %opcode = arith.andi %opcode_shifted, %mask31 : i64
        ac.trace.event %head lane "ROB" phase "retire" : i64
        %is_opcode0 = arith.cmpi eq, %opcode, %c0 : i64
        scf.if %is_opcode0 {
          ac.stat.add @opcode_0 %retired_one : i64
        }
        %is_opcode1 = arith.cmpi eq, %opcode, %c1 : i64
        scf.if %is_opcode1 {
          ac.stat.add @opcode_1 %retired_one : i64
        }
        %is_opcode2 = arith.cmpi eq, %opcode, %c2 : i64
        scf.if %is_opcode2 {
          ac.stat.add @opcode_2 %retired_one : i64
        }
        %is_opcode3 = arith.cmpi eq, %opcode, %c3 : i64
        scf.if %is_opcode3 {
          ac.stat.add @opcode_3 %retired_one : i64
        }
        %is_opcode4 = arith.cmpi eq, %opcode, %c4 : i64
        scf.if %is_opcode4 {
          ac.stat.add @opcode_4 %retired_one : i64
        }
        %is_opcode5 = arith.cmpi eq, %opcode, %c5 : i64
        scf.if %is_opcode5 {
          ac.stat.add @opcode_5 %retired_one : i64
        }
        %is_opcode_vec = arith.cmpi uge, %opcode, %c6 : i64
        scf.if %is_opcode_vec {
          ac.stat.add @opcode_vec %retired_one : i64
        }
        %is_engine_s = arith.cmpi eq, %opcode, %c0 : i64
        scf.if %is_engine_s {
          ac.stat.add @scalar %retired_one : i64
        }
        %is_engine_c0 = arith.cmpi eq, %opcode, %c3 : i64
        %is_engine_c1 = arith.cmpi eq, %opcode, %c4 : i64
        %is_engine_c = arith.ori %is_engine_c0, %is_engine_c1 : i1
        scf.if %is_engine_c {
          ac.stat.add @cube %retired_one : i64
        }
        %is_engine_t0 = arith.cmpi eq, %opcode, %c1 : i64
        %is_engine_t1 = arith.cmpi eq, %opcode, %c5 : i64
        %is_engine_t = arith.ori %is_engine_t0, %is_engine_t1 : i1
        scf.if %is_engine_t {
          ac.stat.add @tlsu %retired_one : i64
        }
        %not_s = arith.cmpi ne, %opcode, %c0 : i64
        %not_c = arith.xori %is_engine_c, %true : i1
        %not_t = arith.xori %is_engine_t, %true : i1
        %is_engine_v0 = arith.andi %not_s, %not_c : i1
        %is_engine_v = arith.andi %is_engine_v0, %not_t : i1
        scf.if %is_engine_v {
          ac.stat.add @vector %retired_one : i64
        }
      }
      %total, %has_total = ac.try_recv @Core::@trace_total : i64
      %all_retired = arith.cmpi eq, %new_head, %total : i64
      %nonzero_total = arith.cmpi ne, %total, %c0 : i64
      %eof_done0 = arith.andi %has_total, %nonzero_total : i1
      %eof_done = arith.andi %eof_done0, %all_retired : i1
      %rob_occ = arith.subi %new_tail, %new_head : i64
      ac.trace.counter %rob_occ lane "ROB" : i64
      scf.if %eof_done {
        ac.assert %eof_done, "retired"
      }
      %head_stored = ac.try_send @head %new_head : i64
      %tail_stored = ac.try_send @tail %new_tail : i64
      %done0_stored = ac.try_send @done0 %nd0 : i64
      %done1_stored = ac.try_send @done1 %nd1 : i64
      %done2_stored = ac.try_send @done2 %nd2 : i64
      %done3_stored = ac.try_send @done3 %nd3 : i64
      %done4_stored = ac.try_send @done4 %nd4 : i64
      %done5_stored = ac.try_send @done5 %nd5 : i64
      %done6_stored = ac.try_send @done6 %nd6 : i64
      %done7_stored = ac.try_send @done7 %nd7 : i64
      %done8_stored = ac.try_send @done8 %nd8 : i64
      %done9_stored = ac.try_send @done9 %nd9 : i64
      %done10_stored = ac.try_send @done10 %nd10 : i64
      %done11_stored = ac.try_send @done11 %nd11 : i64
      %done12_stored = ac.try_send @done12 %nd12 : i64
      %done13_stored = ac.try_send @done13 %nd13 : i64
      %done14_stored = ac.try_send @done14 %nd14 : i64
      %done15_stored = ac.try_send @done15 %nd15 : i64
      %done16_stored = ac.try_send @done16 %nd16 : i64
      %done17_stored = ac.try_send @done17 %nd17 : i64
      %done18_stored = ac.try_send @done18 %nd18 : i64
      %done19_stored = ac.try_send @done19 %nd19 : i64
      %done20_stored = ac.try_send @done20 %nd20 : i64
      %done21_stored = ac.try_send @done21 %nd21 : i64
      %done22_stored = ac.try_send @done22 %nd22 : i64
      %done23_stored = ac.try_send @done23 %nd23 : i64
      %done24_stored = ac.try_send @done24 %nd24 : i64
      %done25_stored = ac.try_send @done25 %nd25 : i64
      %done26_stored = ac.try_send @done26 %nd26 : i64
      %done27_stored = ac.try_send @done27 %nd27 : i64
      %done28_stored = ac.try_send @done28 %nd28 : i64
      %done29_stored = ac.try_send @done29 %nd29 : i64
      %done30_stored = ac.try_send @done30 %nd30 : i64
      %done31_stored = ac.try_send @done31 %nd31 : i64
      ac.yield_sim
    }
    ac.return
  }

  ac.module @Rename() parameters {} graph {
    ac.process @step kind "control" {
      %handle, %valid = ac.try_recv @Core::@rob_to_rename : i64
      scf.if %valid {
        %sent = ac.try_send @Core::@rename_to_dispatch %handle : i64
      }
      ac.yield_sim
    }
    ac.return
  }

  ac.module @Dispatch() parameters {} graph {
    ac.stat @dispatched kind "counter"
    ac.process @step kind "control" {
      %c0 = arith.constant 0 : i64
      %c1 = arith.constant 1 : i64
      %c2 = arith.constant 2 : i64
      %c3 = arith.constant 3 : i64
      %c4 = arith.constant 4 : i64
      %c5 = arith.constant 5 : i64
      %c8 = arith.constant 8 : i64
      %mask31 = arith.constant 31 : i64
      %true = arith.constant true
      %handle, %valid = ac.try_recv @Core::@rename_to_dispatch : i64
      scf.if %valid {
        ac.stat.add @dispatched %c1 : i64
        ac.trace.event %handle lane "Dispatch" phase "dispatch" : i64
        %desc = ac.trace.decode %handle : i64 to i64
        %shifted = arith.shrui %desc, %c8 : i64
        %opcode = arith.andi %shifted, %mask31 : i64
        // Opcode-to-engine routing belongs to this architecture model.
        %is_s = arith.cmpi eq, %opcode, %c0 : i64
        %is_c0 = arith.cmpi eq, %opcode, %c3 : i64
        %is_c1 = arith.cmpi eq, %opcode, %c4 : i64
        %is_c = arith.ori %is_c0, %is_c1 : i1
        %is_t0 = arith.cmpi eq, %opcode, %c1 : i64
        %is_t1 = arith.cmpi eq, %opcode, %c5 : i64
        %is_t = arith.ori %is_t0, %is_t1 : i1
        %not_s = arith.xori %is_s, %true : i1
        %not_c = arith.xori %is_c, %true : i1
        %not_t = arith.xori %is_t, %true : i1
        %is_v0 = arith.andi %not_s, %not_c : i1
        %is_v = arith.andi %is_v0, %not_t : i1
        scf.if %is_s { %sent_s = ac.try_send @Core::@dispatch_to_iq_s %handle : i64 }
        scf.if %is_v { %sent_v = ac.try_send @Core::@dispatch_to_iq_v %handle : i64 }
        scf.if %is_c { %sent_c = ac.try_send @Core::@dispatch_to_iq_c %handle : i64 }
        scf.if %is_t { %sent_t = ac.try_send @Core::@dispatch_to_iq_t %handle : i64 }
      }
      ac.yield_sim
    }
    ac.return
  }

  ac.module @CompletionBroadcast() parameters {} graph {
    ac.stat @completed kind "counter"
    ac.process @step kind "control" {
      %one = arith.constant 1 : i64
      %handle, %valid = ac.try_recv @Core::@wakeup : i64
      scf.if %valid {
        ac.stat.add @completed %one : i64
        ac.trace.event %handle lane "Complete" phase "complete" : i64
        %rob = ac.try_send @Core::@rob_done %handle : i64
        %s = ac.try_send @Core::@ready_to_iq_s %handle : i64
        %v = ac.try_send @Core::@ready_to_iq_v %handle : i64
        %c = ac.try_send @Core::@ready_to_iq_c %handle : i64
        %t = ac.try_send @Core::@ready_to_iq_t %handle : i64
      }
      ac.yield_sim
    }
    ac.return
  }

