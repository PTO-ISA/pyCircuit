        ownership "exclusive" id "slot26" path "slot26" watermarks {kind = "register"}
    ac.queue @slot27 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "slot27" path "slot27" watermarks {kind = "register"}
    ac.queue @slot28 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "slot28" path "slot28" watermarks {kind = "register"}
    ac.queue @slot29 payload i64 entries 1 ordering "fifo" protocol @rv
        ownership "exclusive" id "slot29" path "slot29" watermarks {kind = "register"}
