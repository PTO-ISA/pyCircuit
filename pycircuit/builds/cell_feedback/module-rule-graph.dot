digraph rules {
  rankdir=LR;
  graph [fontname="DejaVu Sans", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#3b82f6", fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.8];
  label="CellFeedback — Module / rule order\nSolid: SB order\nRed: confirmed cycle | Orange: unproven order\nConditional edges retain path/guard details in tooltips";
  subgraph cluster_m0 {
    label="Module: top";
    color="#94a3b8"; style="rounded"; labeljust=l;
    r0 [label="rule: update_a", tooltip="top.update_a"];
    r1 [label="rule: update_b", tooltip="top.update_b"];
  }
}
