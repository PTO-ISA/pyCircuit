digraph rules {
  rankdir=LR;
  graph [fontname="DejaVu Sans", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#3b82f6", fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.8];
  label="SharedState — Module / rule order\nSolid: SB order\nRed: confirmed cycle | Orange: unproven order\nConditional edges retain path/guard details in tooltips";
  subgraph cluster_m5 {
    label="Module: top";
    color="#94a3b8"; style="rounded"; labeljust=l;
    m5_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="first.full (EHR: 2 ports)\nsecond.full (EHR: 2 ports)\nthird.full (EHR: 2 ports)", tooltip="[{\"resource\": \"first\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}, {\"resource\": \"second\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}, {\"resource\": \"third\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}]"];
    subgraph cluster_m0 {
      label="Module: independent";
      color="#94a3b8"; style="rounded"; labeljust=l;
      m0_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="independent.out.full (EHR: 2 ports)", tooltip="[{\"resource\": \"independent.out\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}]"];
      r0 [label="rule: transfer\nEHR: independent.out.full p1 query.full\nthird.full p0 write", tooltip="independent.transfer"];
    }
    subgraph cluster_m1 {
      label="Module: left";
      color="#94a3b8"; style="rounded"; labeljust=l;
      m1_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="left.out.full (EHR: 2 ports)", tooltip="[{\"resource\": \"left.out\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}]"];
      r1 [label="rule: transfer\nEHR: first.full p0 write\nleft.out.full p1 query.full", tooltip="left.transfer"];
    }
    subgraph cluster_m2 {
      label="Module: right";
      color="#94a3b8"; style="rounded"; labeljust=l;
      m2_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="right.out.full (EHR: 2 ports)", tooltip="[{\"resource\": \"right.out\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}]"];
      r2 [label="rule: transfer\nEHR: right.out.full p1 query.full\nsecond.full p0 write", tooltip="right.transfer"];
    }
    subgraph cluster_m3 {
      label="Module: separate";
      color="#94a3b8"; style="rounded"; labeljust=l;
      m3 [label="methods\nadd", shape=plaintext, fillcolor="white", fontcolor="#64748b", fontsize=10];
    }
    subgraph cluster_m4 {
      label="Module: shared";
      color="#94a3b8"; style="rounded"; labeljust=l;
      m4 [label="methods\nadd", shape=plaintext, fillcolor="white", fontcolor="#64748b", fontsize=10];
    }
  }
  m3 -> m4 [style=invis, weight=2];
}
