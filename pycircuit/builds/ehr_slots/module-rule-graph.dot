digraph rules {
  rankdir=LR;
  graph [fontname="DejaVu Sans", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#3b82f6", fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.8];
  label="EHRSlots — Module / rule order\nSolid: SB order\nRed: confirmed cycle | Orange: unproven order\nConditional edges retain path/guard details in tooltips";
  subgraph cluster_m1 {
    label="Module: top";
    color="#94a3b8"; style="rounded"; labeljust=l;
    r0 [label="rule: allocate\nEHR: slot.occupied.value p1 read\nslot.occupied.value p2 write", tooltip="top.allocate"];
    r1 [label="rule: release\nEHR: slot.occupied.value p0 write", tooltip="top.release"];
    subgraph cluster_m0 {
      label="Module: slot";
      color="#94a3b8"; style="rounded"; labeljust=l;
      m0_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="slot.occupied.value (EHR: 3 ports)", tooltip="[{\"resource\": \"slot.occupied\", \"aspect\": \"value\", \"port_count\": 3, \"bindings\": [{\"method\": \"$direct\", \"port\": 0}, {\"method\": \"Module:slot:allocate\", \"port\": 2}, {\"method\": \"Module:slot:available\", \"port\": 1}, {\"method\": \"Module:slot:release\", \"port\": 0}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"transaction\"}]"];
      m0 [label="methods\nallocate, available\nrelease", shape=plaintext, fillcolor="white", fontcolor="#64748b", fontsize=10];
    }
  }
