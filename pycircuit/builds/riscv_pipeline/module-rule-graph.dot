digraph rules {
  rankdir=LR;
  graph [fontname="DejaVu Sans", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#3b82f6", fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.8];
  label="Pipeline — Module / rule order\nSolid: SB order\nRed: confirmed cycle | Orange: unproven order\nConditional edges retain path/guard details in tooltips";
  subgraph cluster_m6 {
    label="Module: top";
    color="#94a3b8"; style="rounded"; labeljust=l;
    m6_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="retirement.full (EHR: 2 ports)", tooltip="[{\"resource\": \"retirement\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}]"];
