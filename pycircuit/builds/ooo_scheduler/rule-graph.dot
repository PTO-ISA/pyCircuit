digraph Transactions {
  rankdir=LR;
  node [shape=box];
  t0 [label="top.scheduler.issue_add#0"];
  t1 [label="top.scheduler.issue_mul#1"];
  t2 [label="top.adder.execute#2"];
  t3 [label="top.multiplier.accept#3"];
  t4 [label="top.multiplier.advance#4"];
  t5 [label="top.cdb.broadcast#5"];
  t6 [label="top.dispatch.dispatch#6"];
  t7 [label="top.commit.commit#7"];
  t8 [label="top.audit.observe#8"];
  t5 -> t2 [label="top.add_done\nQueue.pop \u2192 push"];
  t2 -> t0 [label="top.add_requests\nQueue.pop \u2192 push"];
  t5 -> t8 [label="top.event\nSignal.set \u2192 get"];
  t5 -> t4 [label="top.mul_done\nQueue.pop \u2192 push"];
