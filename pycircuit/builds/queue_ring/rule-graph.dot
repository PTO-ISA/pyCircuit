digraph rules {
  rankdir=LR;
  "top.backward" [label="top.backward\nEHR: left.full p1 query.full\nright.full p0 write"];
  "top.forward" [label="top.forward\nEHR: left.full p0 write\nright.full p1 query.full"];
  "top.backward" -> "top.forward" [label="method.order: right\\ntrue\\npop SB push [derived]"];
  "top.backward" -> "top.forward" [label="method.order: right\\ntrue\\np0 \u2192 p1\\npop SB query.full [derived]"];
  "top.backward" -> "top.forward" [label="method.order: right\\ntrue\\npeek SB push [default,derived]"];
  "top.forward" -> "top.backward" [label="method.order: left\\ntrue\\npeek SB push [default,derived]"];
  "top.forward" -> "top.backward" [label="method.order: left\\ntrue\\np0 \u2192 p1\\npop SB query.full [derived]"];
  "top.forward" -> "top.backward" [label="method.order: left\\ntrue\\npop SB push [derived]"];
}
