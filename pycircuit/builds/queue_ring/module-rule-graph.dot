digraph rules {
  rankdir=LR;
  graph [fontname="DejaVu Sans", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#3b82f6", fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.8];
  label="QueueRing — Module / rule order\nSolid: SB order\nRed: confirmed cycle | Orange: unproven order\nConditional edges retain path/guard details in tooltips";
  subgraph cluster_m0 {
    label="Module: top";
    color="#94a3b8"; style="rounded"; labeljust=l;
    m0_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="left.full (EHR: 2 ports)\nright.full (EHR: 2 ports)", tooltip="[{\"resource\": \"left\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}, {\"resource\": \"right\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}]"];
    r0 [label="rule: backward\nEHR: left.full p1 query.full\nright.full p0 write", tooltip="top.backward"];
    r1 [label="rule: forward\nEHR: left.full p0 write\nright.full p1 query.full", tooltip="top.forward"];
  }
  r0 -> r1 [label="right\npop SB push; pop SB query.full p0 → p1; read SB push\n[default, derived]", color="#dc2626", style="solid", penwidth=2, tooltip="[{\"source\": \"top.backward\", \"target\": \"top.forward\", \"kind\": \"method.order\", \"resource\": \"right\", \"condition\": true, \"operations\": [\"write\", \"query.full\"], \"locations\": [{\"column\": 16, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 54}, {\"column\": 9, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 50}], \"via\": null, \"source_access\": \"0658e86c4673261a\", \"target_access\": \"67a4fc0351821fcd\", \"relation\": \"SB\", \"contract\": \"Queue\", \"interfaces\": [\"pop\", \"query.full\"], \"provenance\": [{\"before\": \"Queue:pop\", \"after\": \"Queue:query.full\", \"relation\": \"SB\", \"source\": \"derived\", \"origin\": \"EHR prior-port visibility\", \"ports\": [0, 1], \"provenance\": [{\"before\": \"pop\", \"after\": \"query.full\", \"relation\": \"SB\", \"source\": \"derived\", \"origin\": \"EHR full prior-port visibility\"}]}]}, {\"source\": \"top.backward\", \"target\": \"top.forward\", \"kind\": \"method.order\", \"resource\": \"right\", \"condition\": true, \"operations\": [\"pop\", \"push\"], \"locations\": [{\"column\": 16, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 54}, {\"column\": 9, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 50}], \"via\": null, \"source_access\": \"080afd95649f4220\", \"target_access\": \"a8faf7769b4029ce\", \"relation\": \"SB\", \"contract\": \"Queue\", \"interfaces\": [\"pop\", \"push\"], \"provenance\": [{\"before\": \"pop\", \"after\": \"query.full\", \"relation\": \"SB\", \"source\": \"derived\", \"origin\": \"EHR full prior-port visibility\"}, {\"before\": \"query.full\", \"after\": \"push\", \"relation\": \"SB\", \"source\": \"derived\", \"origin\": \"push guard calls query.full\"}]}, {\"source\": \"top.backward\", \"target\": \"top.forward\", \"kind\": \"method.order\", \"resource\": \"right\", \"condition\": true, \"operations\": [\"read\", \"push\"], \"locations\": [{\"column\": 16, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 54}, {\"column\": 9, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 50}], \"via\": null, \"source_access\": \"8c012a2a1c5773eb\", \"target_access\": \"a8faf7769b4029ce\", \"relation\": \"SB\", \"contract\": \"Queue\", \"interfaces\": [\"read\", \"push\"], \"provenance\": [{\"after\": \"revise\", \"before\": \"read\", \"origin\": \"Pipeline FIFO\", \"relation\": \"SB\", \"source\": \"default\"}, {\"after\": \"pop\", \"before\": \"revise\", \"origin\": \"Pipeline FIFO\", \"relation\": \"SB\", \"source\": \"default\"}, {\"before\": \"pop\", \"after\": \"query.full\", \"relation\": \"SB\", \"source\": \"derived\", \"origin\": \"EHR full prior-port visibility\"}, {\"before\": \"query.full\", \"after\": \"push\", \"relation\": \"SB\", \"source\": \"derived\", \"origin\": \"push guard calls query.full\"}]}]"];
  r1 -> r0 [label="left\npop SB push; pop SB query.full p0 → p1; read SB push\n[default, derived]", color="#dc2626", style="solid", penwidth=2, tooltip="[{\"source\": \"top.forward\", \"target\": \"top.backward\", \"kind\": \"method.order\", \"resource\": \"left\", \"condition\": true, \"operations\": [\"read\", \"push\"], \"locations\": [{\"column\": 16, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 50}, {\"column\": 9, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 54}], \"via\": null, \"source_access\": \"492f8b9a5cef545c\", \"target_access\": \"6420228f6aff3d51\", \"relation\": \"SB\", \"contract\": \"Queue\", \"interfaces\": [\"read\", \"push\"], \"provenance\": [{\"after\": \"revise\", \"before\": \"read\", \"origin\": \"Pipeline FIFO\", \"relation\": \"SB\", \"source\": \"default\"}, {\"after\": \"pop\", \"before\": \"revise\", \"origin\": \"Pipeline FIFO\", \"relation\": \"SB\", \"source\": \"default\"}, {\"before\": \"pop\", \"after\": \"query.full\", \"relation\": \"SB\", \"source\": \"derived\", \"origin\": \"EHR full prior-port visibility\"}, {\"before\": \"query.full\", \"after\": \"push\", \"relation\": \"SB\", \"source\": \"derived\", \"origin\": \"push guard calls query.full\"}]}, {\"source\": \"top.forward\", \"target\": \"top.backward\", \"kind\": \"method.order\", \"resource\": \"left\", \"condition\": true, \"operations\": [\"pop\", \"push\"], \"locations\": [{\"column\": 16, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 50}, {\"column\": 9, \"file\": \"/home/lc/tmp/pycircuit/examples/dependency_cycles.py\", \"line\": 54}], \"via\": null, \"source_access\": \"58b56eec82e82596\", \"target_access\": \"6420228f6aff3d51\", \"relation\": \"SB\", \"contract\": \"Queue\", \"interfaces\": [\"pop\", \"push\"], \"provenance\": [{\"before\": \"pop\", \"after\": \"query.full\", \"relation\": \"SB\", \"source\": \"derived\", \"origin\": \"EHR full prior-port visibil