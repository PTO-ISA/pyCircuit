digraph rules {
  rankdir=LR;
  graph [fontname="DejaVu Sans", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#3b82f6", fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.8];
  label="DualChannel — Module / rule order\nSolid: SB order\nRed: confirmed cycle | Orange: unproven order\nConditional edges retain path/guard details in tooltips";
  subgraph cluster_m1 {
    label="Module: top";
    color="#94a3b8"; style="rounded"; labeljust=l;
    m1_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="left_out.full (EHR: 2 ports)\nright_out.full (EHR: 2 ports)\nsource.full (EHR: 2 ports)", tooltip="[{\"resource\": \"left_out\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}, {\"resource\": \"right_out\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}, {\"resource\": \"source\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}]"];
    r0 [label="rule: left\nEHR: left_out.full p1 query.full", tooltip="top.left"];
    r1 [label="rule: right\nEHR: right_out.full p1 query.full", tooltip="top.right"];
    subgraph cluster_m0 {
      label="Module: observer";
      color="#94a3b8"; style="rounded"; labeljust=l;
      m0 [label="methods\npeek", shape=plaintext, fillcolor="white", fontcolor="#64748b", fontsize=10];
    }
  }
}
