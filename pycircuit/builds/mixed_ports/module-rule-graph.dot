digraph rules {
  rankdir=LR;
  graph [fontname="DejaVu Sans", bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#3b82f6", fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.8];
  label="MixedPorts — Module / rule order\nSolid: SB order\nRed: confirmed cycle | Orange: unproven order\nConditional edges retain path/guard details in tooltips";
  subgraph cluster_m3 {
    label="Module: top";
    color="#94a3b8"; style="rounded"; labeljust=l;
    m3_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="source.full (EHR: 2 ports)", tooltip="[{\"resource\": \"source\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}]"];
    subgraph cluster_m0 {
      label="Module: ledger";
      color="#94a3b8"; style="rounded"; labeljust=l;
      m0 [label="methods\nrecord", shape=plaintext, fillcolor="white", fontcolor="#64748b", fontsize=10];
    }
    subgraph cluster_m1 {
      label="Module: observer";
      color="#94a3b8"; style="rounded"; labeljust=l;
      r0 [label="rule: sample", tooltip="observer.sample"];
    }
    subgraph cluster_m2 {
      label="Module: router";
      color="#94a3b8"; style="rounded"; labeljust=l;
      m2_ehr [shape=note, fillcolor="#fef3c7", color="#d97706", fontsize=10, label="router.accepted.full (EHR: 2 ports)", tooltip="[{\"resource\": \"router.accepted\", \"aspect\": \"full\", \"port_count\": 2, \"bindings\": [{\"method\": \"Queue:pop\", \"port\": 0}, {\"method\": \"Queue:query.full\", \"port\": 1}], \"semantics\": \"last_effective_prior_port\", \"fallback\": \"old\", \"same_port\": \"invisible\", \"commit\": \"queue.effects\"}]"];
      r1 [label="rule: route\nEHR: router.accepted.full p1 query.full\nsource.full p0 write", tooltip="router.route"];
    }
  }
  r1 -> r0 [label="router.result\nset SB get\n[default]\n(conditional)", color="#475569", style="solid", penwidth=1.2, tooltip="[{\"source\": \"router.route\", \"target\": \"observer.sample\", \"kind\": \"method.order\", \"resource\": \"router.result\", \"condition\": {\"not\": {\"atom\": \"config:enabled\"}}, \"operations\": [\"write\", \"read\"], \"locations\": [{\"column\": 9, \"file\": \"/home/lc/tmp/pycircuit/examples/mixed_ports.py\", \"line\": 44}, {\"column\": 22, \"file\": \"/home/lc/tmp/pycircuit/examples/mixed_ports.py\", \"line\": 22}], \"via\": null, \"source_access\": \"2e8b6117639975ab\", \"target_access\": \"41a0354d35657d0b\", \"relation\": \"SB\", \"contract\": \"Signal\", \"interfaces\": [\"set\", \"get\"], \"provenance\": [{\"after\": \"get\", \"before\": \"set\", \"origin\": \"Signal current value\", \"relation\": \"SB\", \"source\": \"default\"}]}, {\"source\": \"router.route\", \"target\": \"observer.sample\", \"kind\": \"method.order\", \"resource\": \"router.result\", \"condition\": {\"atom\": \"config:enabled\"}, \"operations\": [\"write\", \"read\"], \"locations\": [{\"column\": 13, \"file\": \"/home/lc/tmp/pycircuit/examples/mixed_ports.py\", \"line\": 42}, {\"column\": 22, \"file\": \"/home/lc/tmp/pycircuit/examples/mixed_ports.py\", \"line\": 22}], \"via\": null, \"source_access\": \"9038424528b52b17\", \"target_access\": \"41a0354d35657d0b\", \"relation\": \"SB\", \"contract\": \"Signal\", \"interfaces\": [\"set\", \"get\"], \"provenance\": [{\"after\": \"get\", \"before\": \"set\", \"origin\": \"Signal current value\", \"relation\": \"SB\", \"source\": \"default\"}]}]"];
}
