@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(PYCIRCUIT_TOOLCHAIN_ROOT "${PACKAGE_PREFIX_DIR}")
set(PYCIRCUIT_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
unset(PYCIRCUIT_DRIVER_EXECUTABLE)
if(EXISTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/pycircuit")
  set(PYCIRCUIT_DRIVER_EXECUTABLE "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/pycircuit")
endif()
set(PYCIRCUIT_RUNTIME_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
unset(PYCIRCUIT_PYTHON_DIR)
if(IS_DIRECTORY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/pycircuit/python")
  set(PYCIRCUIT_PYTHON_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/pycircuit/python")
endif()
if(NOT pycircuit_FIND_COMPONENTS)
  set(pycircuit_FIND_COMPONENTS Runtime)
endif()
foreach(component IN LISTS pycircuit_FIND_COMPONENTS)
  if(component STREQUAL "Runtime" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/pycircuitRuntimeTargets.cmake")
    # Source-only build graphs may query package paths with LANGUAGES NONE.
    # Native consumers discover Threads when loading Runtime with C/C++ enabled.
    if(CMAKE_C_COMPILER_LOADED OR CMAKE_CXX_COMPILER_LOADED)
      find_dependency(Threads)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/pycircuitRuntimeTargets.cmake")
    set(pycircuit_Runtime_FOUND TRUE)
  elseif(component STREQUAL "CompilerDev" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/pycircuitCompilerTargets.cmake")
    # LLVM dependency probes require C even for a C++-only consumer.
    if(NOT CMAKE_C_COMPILER_LOADED)
      enable_language(C)
    endif()
    find_dependency(LLVM 22.1.8 EXACT CONFIG)
    find_dependency(MLIR 22.1.8 EXACT CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/pycircuitCompilerTargets.cmake")
    target_include_directories(pycircuit::pycircuit_project_options SYSTEM INTERFACE ${LLVM_INCLUDE_DIRS} ${MLIR_INCLUDE_DIRS})
    set(pycircuit_CompilerDev_FOUND TRUE)
  else()
    set(pycircuit_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(pycircuit)
