#!/usr/bin/env python3
"""Relocatable launcher for the installed Agentic Circuit CLI."""

from __future__ import annotations

import sys
from pathlib import Path


def _site_packages() -> Path:
    prefix = Path(__file__).resolve().parents[1]
    preferred = prefix.joinpath(
        "lib",
        f"python{sys.version_info.major}.{sys.version_info.minor}",
        "site-packages",
    )
    if preferred.is_dir():
        return preferred
    candidates = sorted((prefix / "lib").glob("python*/site-packages"))
    if len(candidates) != 1:
        raise RuntimeError("installed Agentic Circuit Python package is unavailable")
    return candidates[0]


sys.path.insert(0, str(_site_packages()))

from agentic_circuit._cli import main  # noqa: E402


raise SystemExit(main())
