      "name": "opentitan-sum-tree",
      "source": "vendored-opentitan",
      "module": "prim_sum_tree",
      "interface": {
        "wrapper_module": "pyc_runtime_opentitan_sum_tree",
        "parameters": [
          {
            "name": "NUM_SRC",
            "source": "NumSrc",
            "default": 8
          },
          {
            "name": "SATURATE",
            "source": "Saturate",
            "default": 1
          },
          {
            "name": "IN_WIDTH",
            "source": "InWidth",
            "default": 8
          }
        ],
        "ports": [
          {
            "name": "clk",
            "direction": "input",
            "width": "1",
            "source": "clk_i"
          },
          {
            "name": "rst_n",
            "direction": "input",
            "width": "1",
            "source": "rst_ni"
          },
          {
            "name": "values",
            "direction": "input",
            "width": "NUM_SRC*IN_WIDTH",
            "source": "values_i"
          },
          {
            "name": "valid",
            "direction": "input",
            "width": "NUM_SRC",
            "source": "valid_i"
          },
          {
            "name": "sum",
            "direction": "output",
            "width": "(SATURATE != 0) ? IN_WIDTH : IN_WIDTH + $clog2(NUM_SRC)",
            "source": "sum_value_o"
          },
          {
            "name": "sum_valid",
            "direction": "output",
            "width": "1",
            "source": "sum_valid_o"
          }
        ]
      }
    },
