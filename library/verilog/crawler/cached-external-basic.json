      "commit": "63b7c50d43e462b59506f69d341ff1e40202866d",
      "subdir": ".",
      "license": "Solderpad-Hardware-License-0.51",
      "enabled": true
    },
    {
      "name": "opentitan-prim-cache",
      "provider": "github",
      "url": "https://github.com/lowRISC/opentitan.git",
      "local_path": "${CONFIG_DIR}/../vendor-v0.5/opentitan",
      "commit": "782784584433afe5105385041f1282da0a21e023",
      "subdir": "hw/ip/prim/rtl",
      "license": "Apache-2.0",
      "enabled": true
