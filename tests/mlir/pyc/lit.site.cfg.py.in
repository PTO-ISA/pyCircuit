@LIT_SITE_CFG_IN_HEADER@

config.acir_tools_dir = "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@"
config.acir_test_exec_root = "@CMAKE_CURRENT_BINARY_DIR@"
config.llvm_tools_dir = "@LLVM_TOOLS_BINARY_DIR@"
config.acir_binary_root = "@ACIR_BINARY_DIR@"
config.acir_cxx = "@CMAKE_CXX_COMPILER@"
config.acir_llvm_linker_flags = ""
config.acir_python = "@PYC_TEST_PYTHON@"
config.acir_source_root = "@ACIR_REPO_ROOT@"
config.pyc_test_source_root = "@CMAKE_CURRENT_SOURCE_DIR@"
config.excludes = [
    "canonical-cmp-invalid.mlir",
    "canonical-ops-valid.mlir",
    "canonical-select-invalid.mlir",
    "count-leading-zeros-primitive.mlir",
    "popcount-primitive.mlir",
    "priority-primitive.mlir",
    "removed-vector-op-invalid.mlir",
    "residual-vector-invalid.mlir",
]

lit_config.load_config(config, "@CMAKE_CURRENT_SOURCE_DIR@/../lit.cfg.py")
