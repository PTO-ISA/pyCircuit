# A nested Struct mixes partial data with total controls. Its total ready
# field feeds the producer; only payload/availability fields form a DAG.
# The receiver projects scalar fields, then guards a state write and candidate
# return. Its total ready field remains available before that transaction.
# Selected value availability crosses a clocked Relay and Sink. The Sink guard
# precedes its first value use (state-write/return). Two-owner snapshots and exact
# select X/Z masks expose absent/unselected arms, discard and failed-edge retries.
# REQUIRES: rtl-four-state-parameter-types
# RUN: %python %inputs/structured-gfir-selected-clocked-input-oracle.py > %t.rows
# RUN: %pycircuit_opt %inputs/structured-gfir-selected-field-input.mlir --gfir-verify -o %t.gfir
# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: %python -c 'import json,pathlib,sys; a,b=[json.load(open(p))["port_availability"] for p in sys.argv[1:3]]; assert a==b; w=next(o["availability"] for o in a["outputs"] if o["name"]=="result"); assert isinstance(w,str) and w; assert all(o["availability"] is None for o in a["outputs"] if o["name"]!="result"); p=pathlib.Path(sys.argv[3]); p.mkdir(exist_ok=True); (p/"selected_input_ports.hpp").write_text("#define PYC_RESULT_VALID "+w+"\n"); (p/"selected_input_ports.svh").write_text("`define PYC_RESULT_VALID "+w+"\n")' %t.behavior.json %t.final.json %t
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; for kind in behavior final; do %cxx -std=c++20 -pthread -I%include -I%t -I%t.$kind %inputs/structured-gfir-selected-clocked-input.cpp @%t.$kind/sources.rsp "$RTLIB" -o %t.$kind.exe || exit; %t.$kind.exe %t.rows || exit; done
# RUN: %pycircuit_emit %t.hwir --target verilog --format source > %t.sv
# RUN: %iverilog -g2012 -I%t -s tb -o %t.vvp %t.sv %include/verilog/dffe.v %inputs/structured-gfir-selected-clocked-input.sv
# RUN: %vvp %t.vvp +rows=%t.rows
