# Two calls in one Rule share a candidate, while the independent Rule
# sees committed state. The public lifecycle also exercises edge discard/retry.
# RUN: %pycircuit_opt %inputs/structured-gfir-candidates.mlir --gfir-verify -o %t.gfir
# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; %cxx -std=c++20 -pthread -I%include -I%t.$kind %inputs/structured-gfir-candidates.cpp @%t.$kind/sources.rsp -o %t.$kind.exe || exit; %t.$kind.exe || exit; done
