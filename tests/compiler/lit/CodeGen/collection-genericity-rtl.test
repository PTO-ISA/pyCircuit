# REQUIRES: verilator
# RUN: %pycircuit_emit %inputs/collection_genericity.mlir --target verilog --format source > %t.sv
# RUN: %FileCheck %s --implicit-check-not=pyc_floordiv < %t.sv
# RUN: %verilator --binary --timing -Wno-fatal --top-module tb --Mdir %t.dir %t.sv %inputs/collection_genericity.sv > %t.build.log 2>&1
# RUN: %t.dir/Vtb

# CHECK: function automatic {{.*}} pyc_mod(
# CHECK: pycircuit_types::pyc_mod(
