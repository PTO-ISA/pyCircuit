# Reuse the unchanged DigitalFilter independent signed recurrence and public ABI.
# The native driver also verifies exact X/Z masks, recovery, cancelled proposals,
# held clock levels, reset and executor failure for both C++ targets.
# The unchanged RTL bench supplies the same managed WORK trace. Its optional
# four-state helpers use physical edges without managed commits, so that macro
# is deliberately not enabled here; RTL four-state coverage is not claimed.
# This is correctness acceptance, not the historical issue #430 replay benchmark.
# REQUIRES: rtl-four-state-parameter-types
# RUN: %pycircuit_opt %inputs/structured-gfir-digital-filter.mlir --gfir-verify -o %t.gfir
# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: %python -c 'import json,sys; left,right=(json.load(open(p))["port_availability"] for p in sys.argv[1:]); assert left == right' %t.behavior.json %t.final.json
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; test -f "$RTLIB"; for kind in behavior final; do %cxx -std=c++20 -pthread -I%include -I%t.$kind %src/examples/digital_filter/driver.cpp @%t.$kind/sources.rsp "$RTLIB" -o %t.$kind.exe || exit; done
# RUN: for kind in behavior final; do %t.$kind.exe --config %src/examples/digital_filter/config.json --workers 2 > %t.$kind.stdout || exit; grep '^WORK ' %t.$kind.stdout > %t.$kind.trace || exit; done
# RUN: diff -u %t.behavior.trace %t.final.trace
# RUN: %pycircuit_emit %t.hwir --target verilog --format source > %t.sv
# RUN: %iverilog -g2012 -s tb -o %t.vvp %t.sv %include/verilog/dffe.v %src/examples/digital_filter/rtl_tb.sv
# RUN: %vvp %t.vvp > %t.rtl.stdout
# RUN: grep '^WORK ' %t.rtl.stdout > %t.rtl.trace
# RUN: diff -u %t.behavior.trace %t.rtl.trace
