# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; test -f "$RTLIB"; for kind in behavior final; do %cxx -std=c++20 -pthread -I%include -I%t.$kind %src/examples/rob/driver.cpp @%t.$kind/sources.rsp "$RTLIB" -o %t.$kind.exe || exit; done
# RUN: for kind in behavior final; do for workers in 1 2; do %t.$kind.exe --config %src/examples/rob/config.json --workers $workers > %t.$kind.$workers.stdout || exit; grep '^WORK' %t.$kind.$workers.stdout > %t.$kind.$workers.trace || exit; test "$(wc -l < %t.$kind.$workers.trace)" -eq 569 || exit; done; done
