# Read demand retains its lexical prefix across later guards; enabled byte-read
# addresses are checked every Work, including low clock and reset samples.
# Shared byte-storage oracle checks old-data reads, masks, trailing/OOB bytes,
# read-dependent admission, and whole-sample rollback followed by same-edge retry.
# REQUIRES: rtl-four-state-parameter-types
# RUN: %python %inputs/structured-gfir-byte-transaction-oracle.py > %t.rows
# RUN: %pycircuit_opt %inputs/structured-gfir-byte-transaction.mlir --gfir-verify -o %t.gfir
# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: %python %inputs/structured-gfir-byte-transaction-ports.py %t.behavior.json %t.final.json %t
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; test -f "$RTLIB"; for kind in behavior final; do %cxx -std=c++20 -pthread -I%include -I%t -I%t.$kind %inputs/structured-gfir-byte-transaction.cpp @%t.$kind/sources.rsp "$RTLIB" -o %t.$kind.exe || exit; %t.$kind.exe %t.rows || exit; done
# RUN: %pycircuit_emit %t.hwir --target verilog --format source > %t.sv
# RUN: %iverilog -g2012 -I%t -s tb -o %t.vvp %t.sv %include/verilog/dffe.v %include/verilog/byte_mem.v %inputs/structured-gfir-byte-transaction.sv
# RUN: %vvp %t.vvp +rows=%t.rows
