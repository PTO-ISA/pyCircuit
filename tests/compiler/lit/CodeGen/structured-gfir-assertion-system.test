# Generated drivers must report an assertion failure at the third, falling
# sample (epoch two), before any following active edge or finite completion.
# REQUIRES: rtl-four-state-parameter-types
# RUN: %pycircuit_opt %inputs/structured-gfir-assertion-system.mlir --gfir-verify --mlir-print-debuginfo -o %t.gfir
# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; test -f "$RTLIB"; for kind in behavior final; do %cxx -std=c++20 -pthread -I%include -I%t.$kind %t.$kind/simulation_main.cpp @%t.$kind/sources.rsp "$RTLIB" -o %t.$kind.exe || exit; done
# RUN: not %t.behavior.exe --config %t.behavior/config.json > %t.behavior.stdout 2>&1
# RUN: not %t.final.exe --config %t.final/config.json > %t.final.stdout 2>&1
# RUN: for kind in behavior final; do %python %inputs/structured-gfir-system-result.py %t.$kind.stdout FAILED 2 || exit; done
# RUN: %python -c 'import json,sys; rows=[next(r for r in (json.loads(s) for s in open(p) if s.startswith("{")) if r.get("kind")=="result") for p in sys.argv[1:]]; assert all(r["error"]["phase"] == "check" and r["error"]["code"] == "source_check_failed" and r["error"]["message"] == "system count assertion" for r in rows)' %t.behavior.stdout %t.final.stdout
# RUN: %pycircuit_emit %t.hwir --target verilog --format source > %t.sv
# RUN: %iverilog -g2012 -s pycircuit_sim -o %t.vvp %t.sv %include/verilog/dffe.v
# RUN: not %vvp %t.vvp > %t.rtl.stdout 2>&1
