# Selected sync request/write/result and a direct FIFO-out -> RAM transaction
# share one independent old-data/lifetime oracle. Counts, queued heads and later
# responses expose late false, X/Z rollback, discard, retry and retained RAM reset.
# REQUIRES: rtl-four-state-parameter-types
# RUN: for profile in selected fifo; do %python %inputs/structured-gfir-ram-composition-oracle.py $profile > %t.$profile.rows || exit; %pycircuit_opt %inputs/structured-gfir-$profile-ram.mlir --gfir-verify -o %t.$profile.gfir || exit; done
# RUN: for profile in selected fifo; do %pycircuit_emit %t.$profile.gfir --input-stage gfir --target cpp > %t.$profile.behavior.json || exit; %pycircuit_opt %t.$profile.gfir --gfir-to-hwir --ac-verify-hardware -o %t.$profile.hwir || exit; %pycircuit_emit %t.$profile.hwir --target cpp > %t.$profile.final.json || exit; done
# RUN: for profile in selected fifo; do %python -c 'import json,pathlib,sys; a,b=[json.load(open(p))["port_availability"] for p in sys.argv[1:3]]; assert a==b; w=next(o["availability"] for o in a["outputs"] if o["name"]=="value"); assert isinstance(w,str) and w; assert all(o["availability"] is None for o in a["outputs"] if o["name"]!="value"); p=pathlib.Path(sys.argv[3]); p.mkdir(exist_ok=True); (p/"ram_composition_ports.hpp").write_text("#define PYC_VALUE_VALID "+w+"\n"); (p/"ram_composition_ports.svh").write_text("`define PYC_VALUE_VALID "+w+"\n")' %t.$profile.behavior.json %t.$profile.final.json %t.$profile.controls || exit; for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$profile.$kind.json %t.$profile.$kind || exit; done; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; for profile in selected fifo; do flags=; if test "$profile" = fifo; then flags=-DMIXED; fi; for kind in behavior final; do %cxx -std=c++20 -pthread $flags -I%include -I%t.$profile.controls -I%t.$profile.$kind %inputs/structured-gfir-ram-composition.cpp @%t.$profile.$kind/sources.rsp "$RTLIB" -o %t.$profile.$kind.exe || exit; %t.$profile.$kind.exe %t.$profile.rows || exit; done; done
# RUN: for profile in selected fifo; do flags=; if test "$profile" = fifo; then flags=-DMIXED; fi; %pycircuit_emit %t.$profile.hwir --target verilog --format source > %t.$profile.sv || exit; %iverilog -g2012 $flags -I%t.$profile.controls -s tb -o %t.$profile.vvp %t.$profile.sv %include/verilog/dffe.v %include/verilog/sync_mem.v %include/verilog/fifo.v %inputs/structured-gfir-ram-composition.sv || exit; %vvp %t.$profile.vvp +rows=%t.$profile.rows || exit; done
