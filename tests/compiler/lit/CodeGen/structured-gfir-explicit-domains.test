# Two domains drive remotely updated Storage instances while a direct Storage
# instance of the same definition holds zero. The independent trace checks
# edge/reset behavior, atomic discard and same-high retry after a late fault.
# REQUIRES: rtl-four-state-parameter-types
# RUN: %python %inputs/structured-gfir-explicit-domains-oracle.py > %t.rows
# RUN: %pycircuit_opt %inputs/structured-gfir-explicit-domains.mlir --gfir-verify -o %t.gfir
# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: %python -c 'import json,sys; a,b=[json.load(open(p)) for p in sys.argv[1:]]; assert a["source_check_count"] == b["source_check_count"] > 0; p=a["port_availability"]; assert p == b["port_availability"]; assert p["domains"] == {"clock":None,"reset":None}; assert [r["name"] for r in p["inputs"]] == ["clk_e","rst_e","clk_w","rst_w","allow_e","allow_w"]; assert [r["name"] for r in p["outputs"]] == ["east_value","west_value"]; assert all(r["availability"] is None for r in p["outputs"])' %t.behavior.json %t.final.json
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; test -f "$RTLIB"; for kind in behavior final; do %cxx -std=c++20 -pthread -I%include -I%t.$kind %inputs/structured-gfir-explicit-domains.cpp @%t.$kind/sources.rsp "$RTLIB" -o %t.$kind.exe || exit; %t.$kind.exe %t.rows || exit; done
# RUN: %pycircuit_emit %t.hwir --target verilog --format source > %t.sv
# RUN: %iverilog -g2012 -s tb -o %t.vvp %t.sv %include/verilog/dffe.v %inputs/structured-gfir-explicit-domains.sv
# RUN: %vvp %t.vvp +rows=%t.rows
