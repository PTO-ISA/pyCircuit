# Two instances of one clocked child cross-couple committed outputs. The parent
# owns no storage. Check identity, domain history, discard and late-child errors
# against an independent recurrence using the same public driver for both paths.
# RTL managed four-state execution is not covered by this native lifecycle test.
# RUN: %pycircuit_opt %inputs/structured-gfir-clocked-feedback.mlir --gfir-verify -o %t.gfir
# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; test -f "$RTLIB"; for kind in behavior final; do %cxx -std=c++20 -pthread -I%include -I%t.$kind %inputs/structured-gfir-clocked-feedback.cpp @%t.$kind/sources.rsp "$RTLIB" -o %t.$kind.exe || exit; %t.$kind.exe || exit; done
