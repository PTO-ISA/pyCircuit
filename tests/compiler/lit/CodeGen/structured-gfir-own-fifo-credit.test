# One producer site fills when out is unselected and replaces a full slot when
# the preceding selected out supplies raw credit. A second profile also selects
# in, so an admitted pop can empty the FIFO without an unintended replacement.
# REQUIRES: rtl-four-state-parameter-types
# RUN: for profile in own-fifo-credit selected-fifo-in; do %pycircuit_opt %inputs/structured-gfir-$profile.mlir --gfir-verify -o %t.$profile.gfir || exit; done
# RUN: for profile in own-fifo-credit selected-fifo-in; do %pycircuit_emit %t.$profile.gfir --input-stage gfir --target cpp > %t.$profile.behavior.json || exit; done
# RUN: for profile in own-fifo-credit selected-fifo-in; do %pycircuit_opt %t.$profile.gfir --gfir-to-hwir --ac-verify-hardware -o %t.$profile.hwir || exit; %pycircuit_emit %t.$profile.hwir --target cpp > %t.$profile.final.json || exit; done
# RUN: for profile in own-fifo-credit selected-fifo-in; do for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$profile.$kind.json %t.$profile.$kind || exit; done; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; for profile in own-fifo-credit selected-fifo-in; do FLAGS=; if test "$profile" = selected-fifo-in; then FLAGS=-DSELECTED_IN; fi; for kind in behavior final; do %cxx $FLAGS -std=c++20 -pthread -I%include -I%t.$profile.$kind %inputs/structured-gfir-own-fifo-credit.cpp @%t.$profile.$kind/sources.rsp "$RTLIB" -o %t.$profile.$kind.exe || exit; %t.$profile.$kind.exe > %t.$profile.$kind.rows || exit; done; diff -u %t.$profile.behavior.rows %t.$profile.final.rows || exit; done
# RUN: for profile in own-fifo-credit selected-fifo-in; do %pycircuit_emit %t.$profile.hwir --target verilog --format source > %t.$profile.sv || exit; done
# RUN: for profile in own-fifo-credit selected-fifo-in; do FLAGS=; if test "$profile" = selected-fifo-in; then FLAGS=-DSELECTED_IN; fi; %iverilog $FLAGS -g2012 -s tb -o %t.$profile.vvp %t.$profile.sv %include/verilog/dffe.v %include/verilog/fifo.v %inputs/structured-gfir-own-fifo-credit.sv || exit; %vvp %t.$profile.vvp +rows=%t.$profile.behavior.rows || exit; done
