# Ordered view/out results borrow the old head and share one mixed Struct with
# total committed moves across an actual Module call. Field projections preserve
# their distinct availability while the parent derives and consumes a guard.
# Raw ingress and downstream_pop replacement remain atomic with the late guard,
# egress admission, child count and derived parent guard. Shared independent rows
# cover empty/full, view without pop, X/Z ordering, reset, held/falling and retries.
# REQUIRES: rtl-four-state-parameter-types
# RUN: %python %inputs/structured-gfir-fifo-availability-oracle.py > %t.rows
# RUN: %pycircuit_opt %inputs/structured-gfir-fifo-availability.mlir --gfir-verify -o %t.gfir
# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: %python %inputs/structured-gfir-fifo-availability-ports.py %t.behavior.json %t.final.json %t
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; test -f "$RTLIB"; for kind in behavior final; do %cxx -std=c++20 -pthread -I%include -I%t -I%t.$kind %inputs/structured-gfir-fifo-availability.cpp @%t.$kind/sources.rsp "$RTLIB" -o %t.$kind.exe || exit; %t.$kind.exe %t.rows || exit; done
# RUN: %pycircuit_emit %t.hwir --target verilog --format source > %t.sv
# RUN: %iverilog -g2012 -I%t -s tb -o %t.vvp %t.sv %include/verilog/dffe.v %include/verilog/fifo.v %inputs/structured-gfir-fifo-availability.sv
# RUN: %vvp %t.vvp +rows=%t.rows
