# Carries/candidates include the stopping iteration. First/last break differs
# from natural completion; later X/Z stops are unexecuted after an earlier one.
# Reached X/Z discards all state and the sampled edge, permitting same-high retry.
# REQUIRES: rtl-four-state-parameter-types
# RUN: %python %inputs/structured-gfir-loop-break-oracle.py > %t.rows
# RUN: %pycircuit_opt %inputs/structured-gfir-loop-break.mlir --gfir-verify -o %t.gfir
# RUN: %pycircuit_emit %t.gfir --input-stage gfir --target cpp > %t.behavior.json
# RUN: %pycircuit_opt %t.gfir --gfir-to-hwir --ac-verify-hardware -o %t.hwir
# RUN: %pycircuit_emit %t.hwir --target cpp > %t.final.json
# RUN: %python -c 'import json,pathlib,sys; a,b=[json.load(open(p))["port_availability"] for p in sys.argv[1:3]]; assert a==b; w=next(o["availability"] for o in a["outputs"] if o["name"]=="result"); assert isinstance(w,str) and w; p=pathlib.Path(sys.argv[3]); p.mkdir(exist_ok=True); (p/"loop_break_ports.hpp").write_text("#define PYC_RESULT_VALID "+w+"\n"); (p/"loop_break_ports.svh").write_text("`define PYC_RESULT_VALID "+w+"\n")' %t.behavior.json %t.final.json %t
# RUN: for kind in behavior final; do %python %inputs/unpack_bundle.py %t.$kind.json %t.$kind || exit; done
# RUN: RTLIB="$(dirname %pycircuit_emit)/../runtime/libpyc6_runtime.a"; if test ! -f "$RTLIB"; then RTLIB="$(dirname %pycircuit_emit)/../lib/libpyc6_runtime.a"; fi; for kind in behavior final; do %cxx -std=c++20 -pthread -I%include -I%t -I%t.$kind %inputs/structured-gfir-loop-break.cpp @%t.$kind/sources.rsp "$RTLIB" -o %t.$kind.exe || exit; %t.$kind.exe %t.rows || exit; done
# RUN: %pycircuit_emit %t.hwir --target verilog --format source > %t.sv
# RUN: %iverilog -g2012 -I%t -s tb -o %t.vvp %t.sv %include/verilog/dffe.v %inputs/structured-gfir-loop-break.sv
# RUN: %vvp %t.vvp +rows=%t.rows
