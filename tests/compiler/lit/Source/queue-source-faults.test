# Bounded system source-check rollback; full module-vector coverage stays separate.
# REQUIRES: verilator
# RUN: %python %S/Inputs/queue-source.py --repo %src --source-compiler %pycircuit_source_unit --linker %pycircuit_link --emitter %pycircuit_emit --cxx %cxx --verilator %verilator --iverilog unused --vvp unused --scratch %t.dir --fault-checks-only
