        "cva6_fpga_sram_primitives.sv": "// Candidate-local synthesizable models for the exact CVA6 FPGA SRAM interfaces.\n// These are functional memories, not black boxes; upstream CVA6 RTL is unchanged.\nmodule AsyncDpRam #(\n  parameter int ADDR_WIDTH = 1, parameter int DATA_DEPTH = 2, parameter int DATA_WIDTH = 1\n) (\n  input logic Clk_CI, input logic WrEn_SI,\n  input logic [ADDR_WIDTH-1:0] RdAddr_DI, WrAddr_DI,\n  input logic [DATA_WIDTH-1:0] WrData_DI, output logic [DATA_WIDTH-1:0] RdData_DO\n);\n  logic [DATA_WIDTH-1:0] mem [0:DATA_DEPTH-1];\n  always_ff @(posedge Clk_CI) if (WrEn_SI) mem[WrAddr_DI] <= WrData_DI;\n  always_comb RdData_DO = mem[RdAddr_DI];\nendmodule\n\nmodule SyncDpRam_ind_r_w #(\n  parameter int ADDR_WIDTH = 1, parameter int DATA_DEPTH = 2, parameter int DATA_WIDTH = 1\n) (\n  input logic Clk_CI, input logic WrEn_SI,\n  input logic [ADDR_WIDTH-1:0] RdAddr_DI, WrAddr_DI,\n  input logic [DATA_WIDTH-1:0] WrData_DI, output logic [DATA_WIDTH-1:0] RdData_DO\n);\n  logic [DATA_WIDTH-1:0] mem [0:DATA_DEPTH-1];\n  always_ff @(posedge Clk_CI) begin\n    if (WrEn_SI) mem[WrAddr_DI] <= WrData_DI;\n    RdData_DO <= mem[RdAddr_DI];\n  end\nendmodule\n\nmodule SyncDpRam #(\n  parameter int ADDR_WIDTH = 1, parameter int DATA_DEPTH = 2, parameter int DATA_WIDTH = 1,\n  parameter int OUT_REGS = 0, parameter int SIM_INIT = 0\n) (\n  input logic Clk_CI, input logic Rst_RBI,\n  input logic CSelA_SI, WrEnA_SI, input logic [ADDR_WIDTH-1:0] AddrA_DI,\n  input logic [DATA_WIDTH-1:0] WrDataA_DI, output logic [DATA_WIDTH-1:0] RdDataA_DO,\n  input logic CSelB_SI, WrEnB_SI, input logic [ADDR_WIDTH-1:0] AddrB_DI,\n  input logic [DATA_WIDTH-1:0] WrDataB_DI, output logic [DATA_WIDTH-1:0] RdDataB_DO\n);\n  logic [DATA_WIDTH-1:0] mem [0:DATA_DEPTH-1];\n  always_ff @(posedge Clk_CI or negedge Rst_RBI) begin\n    if (!Rst_RBI) begin RdDataA_DO <= '0; RdDataB_DO <= '0; end\n    else begin\n      if (CSelA_SI) begin\n        if (WrEnA_SI) mem[AddrA_DI] <= WrDataA_DI;\n        RdDataA_DO <= mem[AddrA_DI];\n      end\n      if (CSelB_SI) begin\n        if (WrEnB_SI) mem[AddrB_DI] <= WrDataB_DI;\n        RdDataB_DO <= mem[AddrB_DI];\n      end\n    end\n  end\nendmodule\n"
      },
